# Internal llama.cpp sidecar (Qwen2.5-1.5B-Instruct Q4_K_M).
# Used by fly.llm.toml (courtops-llm) and local docker compose.
# The GGUF is NOT baked in — first boot downloads it onto /models.
FROM ghcr.io/ggml-org/llama.cpp:server

USER root
COPY docker/llm-entrypoint.sh /usr/local/bin/llm-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/llm-entrypoint.sh && chmod +x /usr/local/bin/llm-entrypoint.sh

ENV GGUF_URL=https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/qwen2.5-1.5b-instruct-q4_k_m.gguf \
    GGUF_PATH=/models/model.gguf \
    LLAMA_HOST=:: \
    LLAMA_PORT=8080

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/llm-entrypoint.sh"]
