# Keep the build context small — only backend/, frontend/, and docker/ are copied.
models/
*.gguf
.git
.gitignore
.github/
.archive/
.claude/
# Node dev-tooling. package.json + the lock are kept: the jsbuild stage runs
# `npm ci` and bundles the frontend. node_modules is rebuilt in that stage.
node_modules/
eslint.config.mjs
ruff.toml
# The bundle is built in the jsbuild stage, never copied from the host.
frontend/dist/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
backend/.venv/
backend/.env
**/.DS_Store
docs/
scripts/
*.md
Tournament *.csv
Tournament *.pdf
Dockerfile
.dockerignore
fly.toml
render.yaml
Caddyfile
